{
  "name": "kendeji-frontend",
  "version": "1.13.0",
  "private": true,
  "homepage": "https://github.com/unkn0tted/Kendeji_frontend",
  "bugs": {
    "url": "https://github.com/unkn0tted/Kendeji_frontend/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/unkn0tted/Kendeji_frontend.git"
  },
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "docs:dev": "turbo docs:dev",
    "docs:build": "turbo docs:build",
    "lint": "turbo lint",
    "check": "turbo check",
    "test": "bun test tests apps/subscription-rewriter/src",
    "openapi": "turbo openapi",
    "i18n:extract": "turbo i18n:extract",
    "i18n:sync": "turbo i18n:sync",
    "i18n:status": "turbo i18n:status",
    "package": "bun run build && node scripts/package.mjs"
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@workspace/typescript-config": "workspace:*",
    "i18next-cli": "^1.24.20",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "ultracite": "^6.3.4"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "docs"
  ]
}
