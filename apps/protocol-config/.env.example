PROTOCOL_CONFIG_IMAGE_TAG=1.0.4
PROTOCOL_CONFIG_PORT=3002
# Used with compose.proxy-network.yml for a containerized Nginx/OpenResty.
PROXY_DOCKER_NETWORK=1panel-network
# Must be reachable from the container and expose /v1/admin/user/current.
PPANEL_API_BASE=https://api.example.com
PPANEL_ADMIN_CURRENT_PATH=/v1/admin/user/current
CORS_ORIGIN=*
