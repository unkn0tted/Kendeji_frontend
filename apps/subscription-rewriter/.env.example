# Docker image version. Use a fixed version in production.
REWRITER_IMAGE_TAG=1.4.2
REWRITER_PORT=3003

# Existing Docker network that contains the 1Panel MySQL container.
DATABASE_DOCKER_NETWORK=1panel-network

# MySQL TCP connection. The hostname must be the MySQL container name or
# network alias. Use a URL-safe password (for example, hexadecimal).
DATABASE_URL=mysql://subscription_rewriter:replace_with_password@1Panel-mysql-xxxx:3306/replace_with_database

# Confirmed by the current PPanel schema.
SUBSCRIPTION_TABLE=user_subscribe
SUBSCRIPTION_ID_COLUMN=id
SUBSCRIPTION_TOKEN_COLUMN=token
DATABASE_POOL_SIZE=5
DATABASE_IDLE_TIMEOUT=30

# Existing PPanel backend used only to validate administrator Authorization.
# Prefer an internal/direct domain that proxies all paths to the original
# backend. If port 60003 listens beyond host loopback, this can instead be
# http://host.docker.internal:60003.
PPANEL_API_BASE=https://internal-sub.example.com
PPANEL_ADMIN_CURRENT_PATH=/v1/admin/user/current

UPSTREAM_TIMEOUT_MS=15000
MAX_RESPONSE_BYTES=8388608
# Enable only while port 3003 is restricted to the local Nginx reverse proxy
# and other trusted containers.
TRUST_PROXY_HEADERS=true
CORS_ORIGIN=*
